{
  "description": "Check every Python or Go file Claude edits in an opted-in project, and when the user wraps up a task ask whether any mistake should become a new rule",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edited-file.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/propose-rules.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
