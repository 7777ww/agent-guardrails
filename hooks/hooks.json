{
  "description": "Check every Python or Go file Claude edits in an opted-in project, and before Claude runs git push ask whether any mistake in this change should become a new rule",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edited-file.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/review-before-push.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
